# ---------------------------------------------------------------
#  Copia este archivo a .env y rellénalo.
#  En Vercel, las mismas variables van en Settings → Environment Variables.
# ---------------------------------------------------------------

# Supabase → Project Settings → API
PUBLIC_SUPABASE_URL=
PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Anuncios. Si PUBLIC_ADSENSE_ID está vacío, la web NO muestra ninguno.
# Déjalo así hasta que AdSense te apruebe.
PUBLIC_ADSENSE_ID=
PUBLIC_ADSENSE_SLOT_ARTICULO=
PUBLIC_ADSENSE_SLOT_LISTADO=

# Dominio definitivo, sin barra al final. De aquí salen las URLs canónicas,
# el mapa del sitio, el RSS y los datos estructurados. Si se deja vacío se
# usa el de astro.config.mjs, que es un marcador de posición.
PUBLIC_SITE_URL=
