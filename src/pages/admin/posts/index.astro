---
import Admin from '../../../layouts/Admin.astro';
export const prerender = false;

const db = Astro.locals.db!;
const { data: posts } = await db.from('posts').select('*').order('fecha', { ascending: false });
---
<Admin titulo="Entradas">
  <a class="btn" href="/admin/posts/nueva/">Escribir entrada</a>

  {!posts?.length ? (
    <p class="vacio">Todavía no hay entradas.</p>
  ) : (
    <div class="tabla">
      {posts.map((p) => (
        <div class="item">
          <div class="item__txt">
            <div class="item__t">{p.titulo}</div>
            <div class="item__s">
              {new Date(p.fecha).toLocaleDateString('es-ES', { day: 'numeric', month: 'short', year: 'numeric' })}
              {p.patrocinado ? ' · patrocinada' : ''}
            </div>
          </div>
          <span class:list={['etiqueta', p.publicado ? 'etiqueta--on' : 'etiqueta--off']}>
            {p.publicado ? 'Publicada' : 'Borrador'}
          </span>
          <a href={`/admin/posts/${p.id}/`}>Editar</a>
          {p.publicado && <a href={`/blog/${p.slug}/`} target="_blank">Ver</a>}
        </div>
      ))}
    </div>
  )}
</Admin>
