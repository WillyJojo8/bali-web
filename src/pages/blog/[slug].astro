---
import Base from '../../layouts/Base.astro';
import HuecoAnuncio from '../../components/HuecoAnuncio.astro';
import { getPost } from '../../lib/contenido';
import { aHtml } from '../../lib/markdown';

export const prerender = false;

const { slug } = Astro.params;
const post = await getPost(slug!);
if (!post) return new Response(null, { status: 404, statusText: 'No encontrada' });

const legible = new Date(post.fecha).toLocaleDateString('es-ES', {
  day: 'numeric', month: 'long', year: 'numeric',
});
const cuerpo = aHtml(post.cuerpo);
---
<Base titulo={post.titulo} descripcion={post.resumen} imagen={post.portada_url ?? undefined}>
  <article class="post">
    <header class="post__head">
      <time class="post__fecha" datetime={post.fecha}>{legible}</time>
      <h1 class="post__titulo display">{post.titulo}</h1>
      <p class="post__resumen">{post.resumen}</p>
      {post.etiquetas.length > 0 && (
        <ul class="post__tags">{post.etiquetas.map((t) => <li>{t}</li>)}</ul>
      )}
    </header>

    {post.portada_url && (
      <img class="post__portada" src={post.portada_url} alt={post.portada_alt ?? ''} loading="eager" />
    )}

    {post.patrocinado && (
      <p class="aviso">
        Esta entrada incluye enlaces de afiliado o productos cedidos por la marca.
        Si compras desde aquí, Bali se lleva una comisión sin coste extra para ti.
      </p>
    )}

    <div class="post__cuerpo" set:html={cuerpo} />

    <HuecoAnuncio slot={import.meta.env.PUBLIC_ADSENSE_SLOT_ARTICULO} />

    <a class="post__volver" href="/blog/">← Todas las entradas</a>
  </article>
</Base>

<style>
  .post{padding-top:36px}
  .post__head{margin-bottom:24px}
  .post__fecha{font-family:"Space Mono",monospace;font-size:11px;letter-spacing:.14em;
    text-transform:uppercase;color:var(--tang)}
  .post__titulo{font-size:clamp(34px,9vw,52px);margin:10px 0 0}
  .post__resumen{color:var(--cream-dim);font-size:17px;margin:12px 0 0}
  .post__tags{display:flex;gap:6px;flex-wrap:wrap;list-style:none;padding:0;margin:14px 0 0}
  .post__tags li{font-family:"Space Mono",monospace;font-size:9.5px;letter-spacing:.1em;
    text-transform:uppercase;border:1px solid var(--linea);border-radius:100px;
    padding:3px 8px;color:var(--cream-dim)}
  .post__portada{width:100%;border-radius:var(--radio);margin-bottom:28px}

  .post__cuerpo :global(h2){font-family:"Anybody",sans-serif;font-variation-settings:"wdth" 120;
    font-weight:700;font-size:28px;letter-spacing:-.02em;margin:40px 0 12px;line-height:1.1}
  .post__cuerpo :global(h3){font-size:20px;font-weight:600;margin:30px 0 8px}
  .post__cuerpo :global(p){margin:0 0 18px}
  .post__cuerpo :global(a){color:var(--tang);text-underline-offset:3px}
  .post__cuerpo :global(ul),.post__cuerpo :global(ol){padding-left:20px;margin:0 0 18px}
  .post__cuerpo :global(li){margin-bottom:6px}
  .post__cuerpo :global(img){border-radius:var(--radio);margin:24px 0;max-width:100%}
  .post__cuerpo :global(blockquote){border-left:3px solid var(--pink);margin:24px 0;
    padding:2px 0 2px 16px;color:var(--cream-dim);font-style:italic}

  .post__volver{display:inline-block;margin-top:20px;font-family:"Space Mono",monospace;
    font-size:12px;letter-spacing:.1em;text-transform:uppercase;color:var(--cream-dim);text-decoration:none}
  .post__volver:hover{color:var(--tang)}
</style>
