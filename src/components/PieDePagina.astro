---
import perfil from '../data/perfil.json';
const anio = new Date().getFullYear();
---
<footer class="pie">
  <div class="wrap">
    <nav class="pie__redes">
      {perfil.redes.map((r) => (
        <a href={r.url} target="_blank" rel="noopener">{r.nombre}</a>
      ))}
      <a href={`mailto:${perfil.email}`}>Colaboraciones</a>
    </nav>
    <nav class="pie__legal">
      <a href="/aviso-legal/">Aviso legal</a>
      <a href="/privacidad/">Privacidad</a>
      <a href="/rss.xml">RSS</a>
    </nav>
    <p class="pie__firma">© {anio} {perfil.nombre} · {perfil.raza} · Hecho con patas</p>
  </div>
</footer>

<style>
  .pie{border-top:1px solid var(--linea);margin-top:80px;padding:36px 0 44px;text-align:center}
  .pie nav{display:flex;gap:18px;justify-content:center;flex-wrap:wrap;margin-bottom:14px}
  .pie a{font-size:14px;color:var(--cream-dim);text-decoration:none}
  .pie a:hover{color:var(--tang)}
  .pie__legal a{font-family:"Space Mono",monospace;font-size:11px;letter-spacing:.1em;text-transform:uppercase}
  .pie__firma{font-family:"Space Mono",monospace;font-size:10.5px;letter-spacing:.16em;
    text-transform:uppercase;color:rgba(255,243,233,.3);margin:18px 0 0}
</style>
