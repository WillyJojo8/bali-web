---
import perfil from '../data/perfil.json';
import { getCupones } from '../lib/contenido';
import { descuento } from '../lib/seo';

/**
 * La cinta de arriba leía los cupones del JSON de ejemplo, así que anunciaba
 * códigos que ya no existían en cuanto se empezaba a usar el panel. Ahora
 * sale de la misma consulta que el resto de la web.
 */
const cupones = await getCupones();
const cinta = cupones
  .map((c) => {
    const dto = descuento(c.valor, c.unidad);
    return dto ? `${c.codigo} · −${dto}` : c.codigo;
  })
  .join(' · ');

const ruta = Astro.url.pathname;

/**
 * Solo para decidir si pintamos el enlace al panel: si hay cookie, es que
 * alguien inició sesión alguna vez. Quien mande no es esto, es el middleware.
 */
const hayCookieSesion = Boolean(Astro.cookies.get('sb-access-token')?.value);
---
{cinta && (
  <div class="cinta" aria-hidden="true">
    <div class="cinta__track">
      <span>{cinta} · {cinta} · </span>
      <span>{cinta} · {cinta} · </span>
    </div>
  </div>
)}

<header class="nav">
  <div class="nav__in wrap">
    <a class="nav__logo display" href="/">{perfil.nombre}</a>
    <nav aria-label="Principal">
      <a href="/codigos/" class:list={['nav__link', { on: ruta.startsWith('/codigos') || ruta.startsWith('/tiendas') }]}>Códigos</a>
      <a href="/herramientas/" class:list={['nav__link', { on: ruta.startsWith('/herramientas') }]}>Calculadoras</a>
      <a href="/opiniones/" class:list={['nav__link', { on: ruta.startsWith('/opiniones') }]}>Opiniones</a>
      <a href="/blog/" class:list={['nav__link', { on: ruta.startsWith('/blog') }]}>Blog</a>
      <a href="/buscar/" class="nav__link nav__link--lupa" aria-label="Buscar">⌕</a>
      {hayCookieSesion && <a href="/admin/" class="nav__link nav__link--panel">Panel</a>}
    </nav>
  </div>
</header>

<style>
  .cinta{overflow:hidden;background:var(--pink);padding:8px 0}
  .cinta__track{display:flex;width:max-content;animation:desliza 30s linear infinite}
  .cinta span{font-family:"Space Mono",monospace;font-size:11.5px;letter-spacing:.16em;
    text-transform:uppercase;white-space:nowrap;padding-right:24px;color:#fff}
  @keyframes desliza{to{transform:translateX(-50%)}}

  .nav{border-bottom:1px solid var(--linea);position:sticky;top:0;z-index:40;
    background:rgba(27,15,10,.9);backdrop-filter:blur(10px)}
  .nav__in{display:flex;align-items:center;justify-content:space-between;gap:12px;padding-block:12px}
  .nav__logo{font-size:26px;text-decoration:none;flex-shrink:0}
  /* Con cinco enlaces ya no caben en un móvil estrecho: se deslizan. */
  .nav nav{display:flex;gap:14px;overflow-x:auto;scrollbar-width:none;-webkit-overflow-scrolling:touch}
  .nav nav::-webkit-scrollbar{display:none}
  .nav__link{font-family:"Space Mono",monospace;font-size:12px;letter-spacing:.1em;
    text-transform:uppercase;text-decoration:none;color:var(--cream-dim);padding:4px 0;white-space:nowrap}
  .nav__link:hover{color:var(--cream)}
  .nav__link.on{color:var(--tang);border-bottom:2px solid var(--tang)}
  .nav__link--lupa{font-size:19px;line-height:1;padding:0}
  .nav__link--panel{color:var(--pink);border:1px solid rgba(255,46,99,.4);
    border-radius:100px;padding:4px 11px}
  .nav__link--panel:hover{color:#fff;background:var(--pink);border-color:var(--pink)}
</style>
