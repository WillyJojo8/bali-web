---
import '../styles/global.css';
interface Props { titulo: string }
const { titulo } = Astro.props;
const usuario = Astro.locals.usuario!;
const ruta = Astro.url.pathname;
---
<!DOCTYPE html>
<html lang="es">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width,initial-scale=1" />
  <title>{titulo} · Panel</title>
  <meta name="robots" content="noindex, nofollow" />
  <link href="https://fonts.googleapis.com/css2?family=Anybody:wdth,wght@75..150,400..900&family=Instrument+Sans:wght@400;500;600&family=Space+Mono:wght@400;700&display=swap" rel="stylesheet" />
</head>
<body>
  <header class="pnav">
    <div class="pnav__in">
      <a class="pnav__logo display" href="/admin/">BALI</a>
      <nav>
        <a href="/admin/cupones/" class:list={[{ on: ruta.startsWith('/admin/cupones') }]}>Cupones</a>
        <a href="/admin/posts/" class:list={[{ on: ruta.startsWith('/admin/posts') }]}>Entradas</a>
        <a href="/admin/opiniones/" class:list={[{ on: ruta.startsWith('/admin/opiniones') }]}>Opiniones</a>
      </nav>
      <div class="pnav__yo">
        <a class="pnav__web" href="/" target="_blank" rel="noopener">Ver web ↗</a>
        <span>{usuario.nombre}</span>
        <button id="salir" type="button">Salir</button>
      </div>
    </div>
  </header>

  <main class="panel">
    <h1 class="display">{titulo}</h1>
    <slot />
  </main>

  <script is:inline>
    document.getElementById('salir').addEventListener('click', async () => {
      await fetch('/api/sesion', { method: 'DELETE' });
      location.href = '/';
    });
  </script>

  <style is:global>
    .panel{max-width:820px;margin:0 auto;padding:28px var(--pad) 80px}
    .panel h1{font-size:clamp(30px,7vw,40px);margin:0 0 24px}

    .pnav{border-bottom:1px solid var(--linea);background:var(--bg-2)}
    .pnav__in{max-width:820px;margin:0 auto;padding:12px var(--pad);display:flex;
      align-items:center;gap:18px;flex-wrap:wrap}
    .pnav__logo{font-size:22px;text-decoration:none}
    .pnav nav{display:flex;gap:14px;flex:1}
    .pnav nav a{font-family:"Space Mono",monospace;font-size:11.5px;letter-spacing:.1em;
      text-transform:uppercase;text-decoration:none;color:var(--cream-dim)}
    .pnav nav a.on{color:var(--tang)}
    .pnav__yo{display:flex;align-items:center;gap:10px;font-size:13px;color:var(--cream-dim)}
    .pnav__web{font-family:"Space Mono",monospace;font-size:11px;letter-spacing:.08em;
      text-transform:uppercase;text-decoration:none;color:var(--tang)}
    .pnav__web:hover{color:var(--cream)}
    .pnav__yo button{background:none;border:1px solid var(--linea);color:var(--cream-dim);
      border-radius:8px;padding:6px 10px;font-size:11px;cursor:pointer}

    /* --- formularios --- */
    .campo{display:flex;flex-direction:column;gap:6px;margin-bottom:16px}
    .campo label{font-family:"Space Mono",monospace;font-size:10.5px;letter-spacing:.14em;
      text-transform:uppercase;color:var(--cream-dim)}
    .campo input,.campo textarea,.campo select{
      background:var(--card);border:1px solid var(--linea);border-radius:10px;
      padding:12px 14px;color:var(--cream);font:inherit;font-size:16px;width:100%}
    .campo textarea{min-height:220px;resize:vertical;line-height:1.6;
      font-family:"Space Mono",monospace;font-size:14px}
    .campo small{font-size:12px;color:rgba(255,243,233,.4)}
    .fila{display:grid;grid-template-columns:1fr 1fr;gap:14px}
    @media (max-width:560px){.fila{grid-template-columns:1fr}}

    .check{display:flex;align-items:center;gap:10px;margin-bottom:14px;font-size:15px}
    .check input{width:20px;height:20px;accent-color:var(--pink)}

    .btn{background:var(--pink);color:#fff;border:0;border-radius:11px;padding:14px 22px;
      font-family:"Space Mono",monospace;font-weight:700;font-size:12px;letter-spacing:.1em;
      text-transform:uppercase;cursor:pointer;text-decoration:none;display:inline-block}
    .btn--fantasma{background:none;border:1px solid var(--linea);color:var(--cream-dim)}
    .btn--peligro{background:none;border:1px solid rgba(255,46,99,.5);color:var(--pink)}
    .acciones{display:flex;gap:10px;flex-wrap:wrap;margin-top:24px}

    .tabla{display:flex;flex-direction:column;gap:10px;margin-top:20px}
    .item{background:var(--card);border-radius:12px;padding:14px 16px;display:flex;
      align-items:center;gap:14px;flex-wrap:wrap}
    .item__txt{flex:1;min-width:180px}
    .item__t{font-weight:600;font-size:15px}
    .item__s{font-size:13px;color:var(--cream-dim)}
    .item a{font-family:"Space Mono",monospace;font-size:11px;letter-spacing:.08em;
      text-transform:uppercase;color:var(--tang);text-decoration:none}
    .etiqueta{font-family:"Space Mono",monospace;font-size:9.5px;letter-spacing:.1em;
      text-transform:uppercase;border-radius:100px;padding:3px 9px;border:1px solid var(--linea);
      color:var(--cream-dim)}
    .etiqueta--on{border-color:var(--mint);color:var(--mint)}
    .etiqueta--off{border-color:rgba(255,243,233,.2);color:rgba(255,243,233,.35)}

    .vacio{color:var(--cream-dim);background:var(--card);border-radius:12px;padding:22px;text-align:center}
  </style>
</body>
</html>
