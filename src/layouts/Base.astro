---
import perfil from '../data/perfil.json';
import Cabecera from '../components/Cabecera.astro';
import PieDePagina from '../components/PieDePagina.astro';
import { sitio, migas as migasLd, grafo } from '../lib/jsonld';
import '../styles/global.css';

interface Props {
  titulo?: string;
  descripcion?: string;
  imagen?: string;
  /** Migas de pan: [{nombre, url}]. La portada no las necesita. */
  miga?: { nombre: string; url: string }[];
  /** Nodos JSON-LD propios de la página (ofertas, artículo, FAQ…). */
  esquema?: Record<string, unknown>[];
  /** true en páginas que no aportan nada a Google (resultados de búsqueda). */
  noindex?: boolean;
  tipo?: 'website' | 'article';
  /** Solo para artículos: fecha en ISO. */
  publicado?: string;
}

const {
  titulo,
  descripcion = perfil.descripcion,
  imagen,
  miga = [],
  esquema = [],
  noindex = false,
  tipo = 'website',
  publicado,
} = Astro.props;

const tituloFinal = titulo ? `${titulo} · ${perfil.nombre}` : perfil.titulo;
const canonical = new URL(Astro.url.pathname, Astro.site);
const og = imagen ? new URL(imagen, Astro.site) : new URL('/og.jpg', Astro.site);

/**
 * Un solo bloque JSON-LD por página, con @graph. La identidad del sitio va
 * siempre; lo demás lo aporta cada página.
 */
const datos = grafo([
  ...sitio(Astro.site, perfil),
  ...(miga.length ? [migasLd(Astro.site, [{ nombre: 'Inicio', url: '/' }, ...miga])] : []),
  ...esquema,
]);

const adsenseId = import.meta.env.PUBLIC_ADSENSE_ID;
---
<!DOCTYPE html>
<html lang="es">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width,initial-scale=1" />
  <title>{tituloFinal}</title>
  <meta name="description" content={descripcion} />
  <link rel="canonical" href={canonical} />
  <meta name="theme-color" content="#1B0F0A" />

  {/*
    max-image-preview:large hace que Google pueda usar la foto grande en el
    resultado; max-snippet:-1 le deja enseñar el texto que quiera. Las dos
    suben el porcentaje de clic sin cambiar de posición.
  */}
  <meta name="robots" content={noindex
    ? 'noindex,follow'
    : 'index,follow,max-image-preview:large,max-snippet:-1,max-video-preview:-1'} />

  <meta property="og:type" content={tipo} />
  <meta property="og:title" content={tituloFinal} />
  <meta property="og:description" content={descripcion} />
  <meta property="og:image" content={og} />
  <meta property="og:url" content={canonical} />
  <meta property="og:site_name" content={perfil.nombre} />
  <meta property="og:locale" content="es_ES" />
  {tipo === 'article' && publicado && <meta property="article:published_time" content={publicado} />}
  <meta name="twitter:card" content="summary_large_image" />
  <meta name="twitter:title" content={tituloFinal} />
  <meta name="twitter:description" content={descripcion} />
  <meta name="twitter:image" content={og} />

  <link rel="alternate" type="application/rss+xml" title={perfil.titulo} href="/rss.xml" />
  <link rel="sitemap" type="application/xml" href="/sitemap.xml" />
  <link rel="icon" href="/favicon.svg" type="image/svg+xml" />

  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Anybody:wdth,wght@75..150,400..900&family=Instrument+Sans:wght@400;500;600&family=Space+Mono:wght@400;700&display=swap" rel="stylesheet" />

  <script type="application/ld+json" is:inline set:html={datos}></script>

  {adsenseId && (
    <script
      async
      src={`https://pagead2.googlesyndication.com/pagead/js/adsbygoogle.js?client=${adsenseId}`}
      crossorigin="anonymous"
    ></script>
  )}

  {/* Analítica de Vercel: sin cookies, no necesita banner de consentimiento. */}
  <script is:inline>
    window.va = window.va || function () { (window.vaq = window.vaq || []).push(arguments); };
  </script>
  <script is:inline defer src="/_vercel/insights/script.js"></script>
</head>
<body>
  <a class="saltar" href="#contenido">Saltar al contenido</a>
  <Cabecera />
  <main class="wrap" id="contenido">
    <slot />
  </main>
  <PieDePagina />
</body>
</html>

<style>
  /* Visible solo al tabular: quien usa teclado se salta el menú de una vez. */
  .saltar{
    position:absolute;left:-9999px;top:8px;z-index:100;background:var(--tang);color:#1B0F0A;
    padding:10px 16px;border-radius:8px;font-weight:700;text-decoration:none;
  }
  .saltar:focus{left:8px}
</style>
