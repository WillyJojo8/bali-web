---
import perfil from '../data/perfil.json';
import Cabecera from '../components/Cabecera.astro';
import PieDePagina from '../components/PieDePagina.astro';
import '../styles/global.css';

interface Props {
  titulo?: string;
  descripcion?: string;
  imagen?: string;
}
const { titulo, descripcion = perfil.descripcion, imagen } = Astro.props;
const tituloFinal = titulo ? `${titulo} · ${perfil.nombre}` : perfil.titulo;
const canonical = new URL(Astro.url.pathname, Astro.site);
const og = imagen ? new URL(imagen, Astro.site) : new URL('/og.jpg', Astro.site);

const adsenseId = import.meta.env.PUBLIC_ADSENSE_ID;
---
<!DOCTYPE html>
<html lang="es">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width,initial-scale=1" />
  <title>{tituloFinal}</title>
  <meta name="description" content={descripcion} />
  <link rel="canonical" href={canonical} />
  <meta name="theme-color" content="#1B0F0A" />

  <meta property="og:type" content="website" />
  <meta property="og:title" content={tituloFinal} />
  <meta property="og:description" content={descripcion} />
  <meta property="og:image" content={og} />
  <meta name="twitter:card" content="summary_large_image" />

  <link rel="alternate" type="application/rss+xml" title={perfil.titulo} href="/rss.xml" />
  <link rel="icon" href="/favicon.svg" type="image/svg+xml" />

  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Anybody:wdth,wght@75..150,400..900&family=Instrument+Sans:wght@400;500;600&family=Space+Mono:wght@400;700&display=swap" rel="stylesheet" />

  {adsenseId && (
    <script
      async
      src={`https://pagead2.googlesyndication.com/pagead/js/adsbygoogle.js?client=${adsenseId}`}
      crossorigin="anonymous"
    ></script>
  )}
</head>
<body>
  <Cabecera />
  <main class="wrap">
    <slot />
  </main>
  <PieDePagina />
</body>
</html>
